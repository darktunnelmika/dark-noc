#!/usr/bin/env bash
set -Eeuo pipefail

VERSION="2.9.26"
ENV_FILE="${DARK_NOC_ENV_FILE:-/etc/dark-noc/hub.env}"
NGINX_SITE="${DARK_NOC_NGINX_SITE:-/etc/nginx/sites-available/dark-noc}"
NGINX_LINK="${DARK_NOC_NGINX_LINK:-/etc/nginx/sites-enabled/dark-noc}"
CERT_DIR="${DARK_NOC_PANEL_CERT_DIR:-/etc/dark-noc/tls}"
ACME_ROOT="${DARK_NOC_ACME_ROOT:-/var/lib/dark-noc-acme}"
BACKUP_ROOT="${DARK_NOC_BACKUP_ROOT:-/var/backups/dark-noc}"
HUB_DIR="${DARK_NOC_HUB_DIR:-/opt/dark-noc/hub}"
LOCAL_AGENT_CONFIG="${DARK_NOC_LOCAL_AGENT_CONFIG:-/etc/dark-noc-agent/config.json}"
CERT_GROUP="${DARK_NOC_CERT_GROUP:-darknoc}"
LETSENCRYPT_LIVE_ROOT="${DARK_NOC_LETSENCRYPT_LIVE_ROOT:-/etc/letsencrypt/live}"
LETSENCRYPT_HOOK_DIR="${DARK_NOC_LETSENCRYPT_HOOK_DIR:-/etc/letsencrypt/renewal-hooks/deploy}"

RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
CYAN=$'\033[0;36m'
DIM=$'\033[2m'
BOLD=$'\033[1m'
RESET=$'\033[0m'

say() { printf '%s\n' "$*"; }
ok() { printf '%s[OK]%s %s\n' "$GREEN" "$RESET" "$*"; }
warn() { printf '%s[WARN]%s %s\n' "$RED" "$RESET" "$*" >&2; }
die() { printf '%s[ERROR]%s %s\n' "$RED" "$RESET" "$*" >&2; exit 1; }

test_mode() {
  # The regression suite runs against an isolated, caller-owned filesystem on
  # GitHub-hosted runners. Never permit the override unless both authoritative
  # paths are contained by that explicit test root.
  [[ -n ${DARK_NOC_TEST_ROOT:-} &&
     "$ENV_FILE" == "$DARK_NOC_TEST_ROOT/"* &&
     "$HUB_DIR" == "$DARK_NOC_TEST_ROOT/"* ]]
}

require_root() {
  [[ ${EUID:-999} -eq 0 ]] && return 0
  test_mode && return 0
  die "Run as root: sudo darknoc"
}

prepare_cert_dir() {
  if test_mode; then
    install -d -m 0710 "$CERT_DIR"
  else
    install -d -m 0710 -o root -g "$CERT_GROUP" "$CERT_DIR"
  fi
}

require_hub() {
  [[ -f "$ENV_FILE" ]] || die "DARK NOC Hub is not installed on this server."
  [[ -d "$HUB_DIR" ]] || die "DARK NOC Hub files are missing."
}

load_config() {
  unset DARK_NOC_PUBLIC_HOST DARK_NOC_PUBLIC_PORT DARK_NOC_HUB_PORT DARK_NOC_PANEL_CERT_MODE DARK_NOC_DATA
  # hub.env is generated by the trusted root installer and is never writable by the service user.
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  : "${DARK_NOC_PUBLIC_HOST:?DARK_NOC_PUBLIC_HOST is missing from hub.env}"
  : "${DARK_NOC_HUB_PORT:?DARK_NOC_HUB_PORT is missing from hub.env}"
  DARK_NOC_PUBLIC_PORT="${DARK_NOC_PUBLIC_PORT:-443}"
  DARK_NOC_PANEL_CERT_MODE="${DARK_NOC_PANEL_CERT_MODE:-selfsigned}"
  DARK_NOC_DATA="${DARK_NOC_DATA:-/var/lib/dark-noc}"
}

set_env_value() {
  local key="$1" value="$2"
  python3 - "$ENV_FILE" "$key" "$value" <<'PY'
import os
import re
import shlex
import sys
from pathlib import Path

path = Path(sys.argv[1])
key, value = sys.argv[2], sys.argv[3]
if not re.fullmatch(r"DARK_NOC_[A-Z0-9_]+", key):
    raise SystemExit("invalid environment key")
lines = path.read_text(encoding="utf-8").splitlines()
replacement = f"{key}={shlex.quote(value)}"
updated = False
for index, line in enumerate(lines):
    if line.startswith(f"{key}="):
        lines[index] = replacement
        updated = True
        break
if not updated:
    lines.append(replacement)
temporary = path.with_name(path.name + ".darknoc-new")
fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as handle:
    handle.write("\n".join(lines) + "\n")
os.chown(temporary, path.stat().st_uid, path.stat().st_gid)
os.replace(temporary, path)
PY
}

is_ip() {
  python3 - "$1" <<'PY' >/dev/null 2>&1
import ipaddress
import sys
ipaddress.ip_address(sys.argv[1])
PY
}

validate_host() {
  python3 - "$1" <<'PY'
import ipaddress
import re
import sys

value = sys.argv[1].strip().rstrip(".").lower()
try:
    ipaddress.ip_address(value)
except ValueError:
    if len(value) > 253 or not re.fullmatch(r"(?=.{1,253}$)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z](?:[a-z0-9-]{0,61}[a-z0-9])?", value):
        raise SystemExit("Enter a valid domain or IP address")
print(value)
PY
}

validate_port() {
  local port="$1"
  [[ "$port" =~ ^[0-9]{1,5}$ ]] || return 1
  (( 10#$port == 443 || (10#$port >= 1024 && 10#$port <= 65535) )) || return 1
  (( 10#$port != 80 )) || return 1
}

url_host() {
  if [[ "$1" == *:* ]]; then printf '[%s]' "$1"; else printf '%s' "$1"; fi
}

panel_url() {
  local host suffix=""
  host="$(url_host "$DARK_NOC_PUBLIC_HOST")"
  [[ "$DARK_NOC_PUBLIC_PORT" == "443" ]] || suffix=":$DARK_NOC_PUBLIC_PORT"
  printf 'https://%s%s' "$host" "$suffix"
}

random_backend_port() {
  python3 - "$1" <<'PY'
import socket
import sys

blocked = int(sys.argv[1])
for _ in range(30):
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        candidate = sock.getsockname()[1]
    if candidate != blocked and candidate >= 1024:
        print(candidate)
        break
else:
    raise SystemExit("could not allocate a backend port")
PY
}

update_local_agent_backend() {
  [[ -f "$LOCAL_AGENT_CONFIG" ]] || return 0
  python3 - "$LOCAL_AGENT_CONFIG" "$DARK_NOC_HUB_PORT" <<'PY'
import json
import os
import sys
from pathlib import Path

path = Path(sys.argv[1])
data = json.loads(path.read_text(encoding="utf-8"))
data["hub_url"] = f"http://127.0.0.1:{int(sys.argv[2])}"
temporary = path.with_name(path.name + ".darknoc-new")
fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w", encoding="utf-8") as handle:
    json.dump(data, handle, indent=2)
    handle.write("\n")
os.replace(temporary, path)
PY
}

ensure_backend_separation() {
  [[ "$DARK_NOC_PUBLIC_PORT" != "$DARK_NOC_HUB_PORT" ]] || {
    local replacement
    replacement="$(random_backend_port "$DARK_NOC_PUBLIC_PORT")" || return 1
    set_env_value DARK_NOC_HUB_PORT "$replacement" || return 1
    DARK_NOC_HUB_PORT="$replacement"
    update_local_agent_backend || return 1
    systemctl daemon-reload || return 1
    systemctl restart dark-noc-hub.service || return 1
    if systemctl cat dark-noc-agent.service >/dev/null 2>&1; then
      systemctl restart dark-noc-agent.service || return 1
    fi
    ok "Internal Hub moved safely to 127.0.0.1:$replacement"
  }
}

cert_matches_host() {
  [[ -s "$CERT_DIR/panel.crt" ]] || return 1
  local san
  san="$(openssl x509 -in "$CERT_DIR/panel.crt" -noout -ext subjectAltName 2>/dev/null || true)"
  if is_ip "$DARK_NOC_PUBLIC_HOST"; then
    grep -Fq "IP Address:$DARK_NOC_PUBLIC_HOST" <<<"$san"
  else
    grep -Fq "DNS:$DARK_NOC_PUBLIC_HOST" <<<"$san"
  fi
}

make_self_signed() {
  prepare_cert_dir || return 1
  local san_type="DNS"
  is_ip "$DARK_NOC_PUBLIC_HOST" && san_type="IP"
  local key_tmp cert_tmp
  key_tmp="$(mktemp "$CERT_DIR/panel.key.XXXXXX")"
  cert_tmp="$(mktemp "$CERT_DIR/panel.crt.XXXXXX")"
  if ! openssl req -x509 -newkey rsa:3072 -sha256 -nodes -days 825 \
    -keyout "$key_tmp" -out "$cert_tmp" -subj "/CN=$DARK_NOC_PUBLIC_HOST/O=DARK NOC" \
    -addext "subjectAltName=$san_type:$DARK_NOC_PUBLIC_HOST" >/dev/null 2>&1; then
    rm -f "$key_tmp" "$cert_tmp"
    return 1
  fi
  if ! test_mode; then
    chown root:root "$key_tmp" || return 1
    chown "root:$CERT_GROUP" "$cert_tmp" || return 1
  fi
  chmod 0600 "$key_tmp" || return 1
  chmod 0640 "$cert_tmp" || return 1
  mv -f "$key_tmp" "$CERT_DIR/panel.key" || return 1
  mv -f "$cert_tmp" "$CERT_DIR/panel.crt" || return 1
  ok "A local TLS certificate was generated for $DARK_NOC_PUBLIC_HOST"
}

ensure_certificate() {
  prepare_cert_dir || return 1
  case "$DARK_NOC_PANEL_CERT_MODE" in
    letsencrypt)
      [[ -s "$LETSENCRYPT_LIVE_ROOT/$DARK_NOC_PUBLIC_HOST/fullchain.pem" ]] || return 1
      [[ -s "$LETSENCRYPT_LIVE_ROOT/$DARK_NOC_PUBLIC_HOST/privkey.pem" ]] || return 1
      ln -sfn "$LETSENCRYPT_LIVE_ROOT/$DARK_NOC_PUBLIC_HOST/fullchain.pem" "$CERT_DIR/panel.crt" || return 1
      ln -sfn "$LETSENCRYPT_LIVE_ROOT/$DARK_NOC_PUBLIC_HOST/privkey.pem" "$CERT_DIR/panel.key" || return 1
      ;;
    selfsigned)
      cert_matches_host || make_self_signed || return 1
      ;;
    *)
      warn "Unknown certificate mode: $DARK_NOC_PANEL_CERT_MODE"
      return 1
      ;;
  esac
}

check_public_port() {
  local holder
  holder="$(ss -H -ltnp "sport = :$DARK_NOC_PUBLIC_PORT" 2>/dev/null || true)"
  if [[ -n "$holder" && "$holder" != *nginx* ]]; then
    warn "Port $DARK_NOC_PUBLIC_PORT is already used by another service:"
    say "$holder"
    return 1
  fi
}

write_nginx_site() {
  local url redirect upload_limit site_tmp
  url="$(panel_url)"
  redirect="$url"
  upload_limit="${DARK_NOC_SSH_UPLOAD_LIMIT_MB:-1024}"
  [[ "$upload_limit" =~ ^[0-9]+$ ]] || upload_limit=1024
  upload_limit=$((10#$upload_limit + 1))
  install -d -m 0755 "$(dirname "$NGINX_SITE")" "$(dirname "$NGINX_LINK")" "$ACME_ROOT/.well-known/acme-challenge" || return 1
  if [[ -f "$NGINX_SITE" ]] && ! grep -qE 'Managed by DARK NOC|proxy_pass http://127\.0\.0\.1:[0-9]+' "$NGINX_SITE"; then
    warn "$NGINX_SITE is not managed by DARK NOC; refusing to overwrite it."
    return 1
  fi
  site_tmp="$(mktemp "${NGINX_SITE}.XXXXXX")" || return 1
  if ! sed \
    -e "s|__HOST__|$DARK_NOC_PUBLIC_HOST|g" \
    -e "s|__PUBLIC_PORT__|$DARK_NOC_PUBLIC_PORT|g" \
    -e "s|__HUB_PORT__|$DARK_NOC_HUB_PORT|g" \
    -e "s|__REDIRECT__|$redirect|g" \
    -e "s|__UPLOAD_LIMIT__|$upload_limit|g" \
    -e "s|__ACME_ROOT__|$ACME_ROOT|g" \
    -e "s|__CERT_DIR__|$CERT_DIR|g" >"$site_tmp" <<'EOF'
# Managed by DARK NOC. Use `darknoc` to change this file.
server {
  listen 80;
  listen [::]:80;
  server_name __HOST__;
  location ^~ /.well-known/acme-challenge/ { root __ACME_ROOT__; }
  location / { return 301 __REDIRECT__$request_uri; }
}
server {
  listen __PUBLIC_PORT__ ssl http2;
  listen [::]:__PUBLIC_PORT__ ssl http2;
  server_name __HOST__;
  ssl_certificate __CERT_DIR__/panel.crt;
  ssl_certificate_key __CERT_DIR__/panel.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:DARKNOC:10m;
  ssl_session_timeout 1d;
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options "nosniff" always;
  client_max_body_size 1m;
  location ^~ /api/ssh/upload/ {
    client_max_body_size __UPLOAD_LIMIT__m;
    proxy_request_buffering off;
    proxy_pass http://127.0.0.1:__HUB_PORT__;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_connect_timeout 86400;
    proxy_send_timeout 86400;
    proxy_read_timeout 86400;
    send_timeout 86400;
  }
  location / {
    proxy_pass http://127.0.0.1:__HUB_PORT__;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600;
  }
}
EOF
  then
    rm -f "$site_tmp"
    return 1
  fi
  chmod 0644 "$site_tmp" || return 1
  mv -f "$site_tmp" "$NGINX_SITE" || return 1
  ln -sfn "$NGINX_SITE" "$NGINX_LINK" || return 1
}

configure_firewall() {
  command -v ufw >/dev/null 2>&1 || return 0
  ufw status | grep -q '^Status: active' || return 0
  ufw allow 80/tcp >/dev/null || return 1
  ufw allow "$DARK_NOC_PUBLIC_PORT/tcp" >/dev/null || return 1
  ufw delete allow "$DARK_NOC_HUB_PORT/tcp" >/dev/null 2>&1 || true
}

apply_gateway() {
  load_config
  validate_port "$DARK_NOC_PUBLIC_PORT" || { warn "Invalid public port: $DARK_NOC_PUBLIC_PORT"; return 1; }
  ensure_backend_separation || return 1
  check_public_port || return 1
  ensure_certificate || { warn "The configured TLS certificate is missing or invalid."; return 1; }
  write_nginx_site || return 1
  nginx -t || return 1
  systemctl enable nginx.service >/dev/null 2>&1 || return 1
  systemctl reload-or-restart nginx.service || return 1
  configure_firewall || return 1
}

install_renew_hook() {
  install -d -m 0755 "$LETSENCRYPT_HOOK_DIR" || return 1
  printf '%s\n' '#!/usr/bin/env bash' 'systemctl reload nginx.service' > "$LETSENCRYPT_HOOK_DIR/dark-noc-reload" || return 1
  chmod 0755 "$LETSENCRYPT_HOOK_DIR/dark-noc-reload" || return 1
}

issue_ssl() {
  load_config
  is_ip "$DARK_NOC_PUBLIC_HOST" && die "Let's Encrypt requires a domain. Set a domain first."
  command -v certbot >/dev/null 2>&1 || die "Certbot is not installed."
  install -d -m 0755 "$ACME_ROOT/.well-known/acme-challenge" || return 1
  # Keep the current certificate active while HTTP-01 validation runs.
  write_nginx_site || return 1
  nginx -t || return 1
  systemctl reload-or-restart nginx.service || return 1
  say "Requesting Let's Encrypt certificate for $DARK_NOC_PUBLIC_HOST ..."
  if ! certbot certonly --webroot --webroot-path "$ACME_ROOT" -d "$DARK_NOC_PUBLIC_HOST" \
    --non-interactive --agree-tos --register-unsafely-without-email --keep-until-expiring; then
    warn "SSL request failed. Verify DNS and inbound TCP port 80, then retry from darknoc."
    return 1
  fi
  set_env_value DARK_NOC_PANEL_CERT_MODE letsencrypt || return 1
  load_config || return 1
  ensure_certificate || return 1
  write_nginx_site || return 1
  nginx -t || return 1
  systemctl reload nginx.service || return 1
  install_renew_hook || return 1
  ok "Valid SSL is active: $(panel_url)"
}

renew_ssl() {
  load_config
  if [[ "$DARK_NOC_PANEL_CERT_MODE" != "letsencrypt" ]]; then
    issue_ssl
    return
  fi
  certbot renew --cert-name "$DARK_NOC_PUBLIC_HOST" --deploy-hook "systemctl reload nginx.service"
  ok "Certificate renewal check completed."
}

snapshot_config() {
  SNAPSHOT_DIR="$(mktemp -d /tmp/darknoc-config.XXXXXX)"
  cp -a "$ENV_FILE" "$SNAPSHOT_DIR/hub.env"
  [[ ! -f "$NGINX_SITE" ]] || cp -a "$NGINX_SITE" "$SNAPSHOT_DIR/nginx-site"
  [[ ! -f "$LOCAL_AGENT_CONFIG" ]] || cp -a "$LOCAL_AGENT_CONFIG" "$SNAPSHOT_DIR/local-agent.json"
  [[ ! -e "$CERT_DIR/panel.crt" ]] || cp -a "$CERT_DIR/panel.crt" "$SNAPSHOT_DIR/panel.crt"
  [[ ! -e "$CERT_DIR/panel.key" ]] || cp -a "$CERT_DIR/panel.key" "$SNAPSHOT_DIR/panel.key"
}

restore_snapshot() {
  cp -a "$SNAPSHOT_DIR/hub.env" "$ENV_FILE"
  if [[ -f "$SNAPSHOT_DIR/nginx-site" ]]; then
    cp -a "$SNAPSHOT_DIR/nginx-site" "$NGINX_SITE"
  else
    rm -f "$NGINX_SITE" "$NGINX_LINK"
  fi
  if [[ -f "$SNAPSHOT_DIR/local-agent.json" ]]; then
    cp -a "$SNAPSHOT_DIR/local-agent.json" "$LOCAL_AGENT_CONFIG"
  fi
  rm -f "$CERT_DIR/panel.crt" "$CERT_DIR/panel.key"
  [[ ! -e "$SNAPSHOT_DIR/panel.crt" ]] || cp -a "$SNAPSHOT_DIR/panel.crt" "$CERT_DIR/panel.crt"
  [[ ! -e "$SNAPSHOT_DIR/panel.key" ]] || cp -a "$SNAPSHOT_DIR/panel.key" "$CERT_DIR/panel.key"
  systemctl daemon-reload || true
  systemctl restart dark-noc-hub.service || true
  systemctl restart dark-noc-agent.service >/dev/null 2>&1 || true
  nginx -t >/dev/null 2>&1 && systemctl reload-or-restart nginx.service || true
}

finish_snapshot() {
  [[ -n "${SNAPSHOT_DIR:-}" && "$SNAPSHOT_DIR" == /tmp/darknoc-config.* ]] && rm -rf "$SNAPSHOT_DIR"
  SNAPSHOT_DIR=""
}

change_port() {
  load_config
  local requested="${1:-}" old_port="$DARK_NOC_PUBLIC_PORT"
  if [[ -z "$requested" ]]; then
    read -r -p "Public panel port [$old_port]: " requested
    requested="${requested:-$old_port}"
  fi
  validate_port "$requested" || die "Use port 443 or a port from 1024 to 65535 (port 80 is reserved for SSL)."
  [[ "$requested" != "$old_port" ]] || { ok "Panel already uses port $requested"; return; }
  snapshot_config
  set_env_value DARK_NOC_PUBLIC_PORT "$requested"
  if apply_gateway; then
    finish_snapshot
    load_config
    ok "Panel port changed: $(panel_url)"
    warn "Synchronize remote Agents from Fleet Ops so they learn the new Hub URL."
  else
    restore_snapshot
    finish_snapshot
    die "Port change failed and the previous configuration was restored."
  fi
}

change_host() {
  load_config
  local requested="${1:-}"
  if [[ -z "$requested" ]]; then
    read -r -p "Panel domain or IP [$DARK_NOC_PUBLIC_HOST]: " requested
    requested="${requested:-$DARK_NOC_PUBLIC_HOST}"
  fi
  requested="${requested#http://}"
  requested="${requested#https://}"
  requested="${requested%%/*}"
  requested="$(validate_host "$requested")" || die "Invalid domain or IP address."
  snapshot_config
  set_env_value DARK_NOC_PUBLIC_HOST "$requested"
  set_env_value DARK_NOC_PANEL_CERT_MODE selfsigned
  if apply_gateway; then
    finish_snapshot
    load_config
    ok "Panel address changed: $(panel_url)"
  else
    restore_snapshot
    finish_snapshot
    die "Address change failed and the previous configuration was restored."
  fi
  if ! is_ip "$requested"; then
    local answer
    read -r -p "Get a valid Let's Encrypt SSL certificate now? [Y/n]: " answer
    [[ "${answer:-y}" =~ ^[Yy]$ ]] && issue_ssl || true
  fi
  warn "Synchronize remote Agents from Fleet Ops after changing the public address."
}

database_path() {
  load_config
  printf '%s/dark-noc.db' "$DARK_NOC_DATA"
}

backup_database() {
  local destination="$1" source
  source="$(database_path)"
  [[ -d "$(dirname "$destination")" ]] || install -d -m 0700 "$(dirname "$destination")"
  python3 - "$source" "$destination" <<'PY'
import sqlite3
import sys
source = sqlite3.connect(sys.argv[1], timeout=30)
destination = sqlite3.connect(sys.argv[2])
with destination:
    source.backup(destination)
destination.close()
source.close()
PY
  chmod 0600 "$destination"
}

show_credentials() {
  load_config
  local db_path
  db_path="$(database_path)"
  CANDIDATE_PASSWORD="${DARK_NOC_ADMIN_PASSWORD:-}" python3 - "$db_path" <<'PY'
import base64
import hashlib
import hmac
import os
import sqlite3
import sys

def verify(password, stored):
    try:
        _, salt, expected = stored.split("$", 2)
        digest = hashlib.scrypt(password.encode(), salt=base64.urlsafe_b64decode(salt), n=2**14, r=8, p=1, dklen=32)
        actual = base64.urlsafe_b64encode(digest).decode()
        return hmac.compare_digest(actual, expected)
    except Exception:
        return False

with sqlite3.connect(sys.argv[1]) as connection:
    row = connection.execute("SELECT username,password_hash FROM users WHERE role='owner' ORDER BY id LIMIT 1").fetchone()
if not row:
    raise SystemExit("No owner account exists")
print(f"Username: {row[0]}")
candidate = os.environ.get("CANDIDATE_PASSWORD", "")
if candidate and verify(candidate, row[1]):
    print(f"Password: {candidate}")
else:
    print("Password: cannot be recovered (it was changed outside darknoc)")
    print("Use Change / reset password to create a new one.")
PY
}

change_username() {
  load_config
  local username="${1:-}" db_path env_backup
  [[ -n "$username" ]] || read -r -p "New username: " username
  [[ "$username" =~ ^[A-Za-z0-9_.-]{3,64}$ ]] || die "Username must be 3-64 characters: letters, numbers, dot, dash or underscore."
  db_path="$(database_path)"
  env_backup="$(mktemp /tmp/darknoc-env.XXXXXX)"
  cp -a "$ENV_FILE" "$env_backup"
  set_env_value DARK_NOC_ADMIN_USER "$username"
  if ! python3 - "$db_path" "$username" <<'PY'
import sqlite3
import sys
import time
with sqlite3.connect(sys.argv[1], timeout=30) as connection:
    row = connection.execute("SELECT id FROM users WHERE role='owner' ORDER BY id LIMIT 1").fetchone()
    if not row:
        raise SystemExit("No owner account exists")
    connection.execute("UPDATE users SET username=? WHERE id=?", (sys.argv[2], row[0]))
    connection.execute("DELETE FROM sessions WHERE user_id=?", (row[0],))
    connection.execute("INSERT INTO audit_logs(user_id,action,target,detail,ip,created_at) VALUES(?,?,?,?,?,?)", (row[0], "server_account_update", sys.argv[2], "Username changed with darknoc CLI", "local-root", int(time.time())))
PY
  then
    cp -a "$env_backup" "$ENV_FILE"
    rm -f "$env_backup"
    die "Username change failed; the previous configuration was restored."
  fi
  rm -f "$env_backup"
  ok "Username changed to $username. Existing browser sessions were signed out."
}

change_password() {
  load_config
  local password="${1:-}" confirm generated=0 db_path env_backup db_backup
  if [[ -z "$password" ]]; then
    read -r -s -p "New password (Enter = generate a strong password): " password
    say ""
    if [[ -z "$password" ]]; then
      password="$(openssl rand -base64 36 | tr -d '\n=/+' | cut -c1-28)"
      generated=1
    else
      read -r -s -p "Confirm new password: " confirm
      say ""
      [[ "$password" == "$confirm" ]] || die "Password confirmation does not match."
    fi
  fi
  (( ${#password} >= 12 )) || die "Password must contain at least 12 characters."
  db_path="$(database_path)"
  env_backup="$(mktemp /tmp/darknoc-env.XXXXXX)"
  db_backup="$(mktemp /tmp/darknoc-db.XXXXXX)"
  cp -a "$ENV_FILE" "$env_backup"
  backup_database "$db_backup"
  set_env_value DARK_NOC_ADMIN_PASSWORD "$password"
  if ! NEW_DARK_NOC_PASSWORD="$password" python3 - "$db_path" <<'PY'
import base64
import hashlib
import os
import secrets
import sqlite3
import sys
import time

password = os.environ["NEW_DARK_NOC_PASSWORD"]
salt = secrets.token_bytes(16)
digest = hashlib.scrypt(password.encode(), salt=salt, n=2**14, r=8, p=1, dklen=32)
stored = f"scrypt${base64.urlsafe_b64encode(salt).decode()}${base64.urlsafe_b64encode(digest).decode()}"
with sqlite3.connect(sys.argv[1], timeout=30) as connection:
    row = connection.execute("SELECT id,username FROM users WHERE role='owner' ORDER BY id LIMIT 1").fetchone()
    if not row:
        raise SystemExit("No owner account exists")
    connection.execute("UPDATE users SET password_hash=? WHERE id=?", (stored, row[0]))
    connection.execute("DELETE FROM sessions WHERE user_id=?", (row[0],))
    connection.execute("INSERT INTO audit_logs(user_id,action,target,detail,ip,created_at) VALUES(?,?,?,?,?,?)", (row[0], "server_account_update", row[1], "Password reset with darknoc CLI", "local-root", int(time.time())))
PY
  then
    cp -a "$env_backup" "$ENV_FILE"
    rm -f "$env_backup" "$db_backup"
    die "Password change failed; SQLite rolled back the account transaction."
  fi
  rm -f "$env_backup" "$db_backup"
  ok "Password changed. All browser sessions were signed out."
  (( generated == 0 )) || say "New password: $password"
}

show_status() {
  load_config
  say ""
  printf '%sDARK NOC SERVER STATUS%s\n' "$BOLD" "$RESET"
  printf 'Panel URL    : %s\n' "$(panel_url)"
  printf 'Public port  : %s/tcp\n' "$DARK_NOC_PUBLIC_PORT"
  printf 'Internal Hub : 127.0.0.1:%s (private)\n' "$DARK_NOC_HUB_PORT"
  printf 'TLS mode     : %s\n' "$DARK_NOC_PANEL_CERT_MODE"
  printf 'Hub service  : %s\n' "$(systemctl is-active dark-noc-hub.service 2>/dev/null || true)"
  printf 'Nginx        : %s\n' "$(systemctl is-active nginx.service 2>/dev/null || true)"
  printf 'Local Agent  : %s\n' "$(systemctl is-active dark-noc-agent.service 2>/dev/null || true)"
  if curl -kfsS -H "Host: $DARK_NOC_PUBLIC_HOST" --max-time 4 "https://127.0.0.1:$DARK_NOC_PUBLIC_PORT/healthz" >/dev/null 2>&1; then
    ok "Public gateway health check passed"
  else
    warn "Public gateway health check failed"
  fi
}

restart_services() {
  systemctl restart dark-noc-hub.service
  systemctl restart dark-noc-agent.service >/dev/null 2>&1 || true
  systemctl reload-or-restart nginx.service
  ok "DARK NOC services restarted."
}

create_backup() {
  load_config
  local stamp destination db_backup
  stamp="$(date -u +%Y%m%d-%H%M%S)"
  destination="$BACKUP_ROOT/$stamp"
  install -d -m 0700 "$destination"
  db_backup="$destination/dark-noc.db"
  backup_database "$db_backup"
  cp -a "$ENV_FILE" "$destination/hub.env"
  [[ ! -f "$NGINX_SITE" ]] || cp -a "$NGINX_SITE" "$destination/nginx-site"
  [[ ! -d "$CERT_DIR" ]] || cp -a "$CERT_DIR" "$destination/tls"
  chmod -R go-rwx "$destination"
  ok "Backup created: $destination"
}

run_update() {
  say "Downloading the latest signed DARK NOC release metadata..."
  bash <(curl --proto '=https' --tlsv1.2 -fsSL https://raw.githubusercontent.com/darktunnelmika/dark-noc/main/install.sh) hub
}

pause_menu() {
  say ""
  read -r -p "Press Enter to return to DARK NOC..." _
}

menu() {
  while true; do
    load_config
    clear 2>/dev/null || true
    printf '%s' "$CYAN"
    say '╔══════════════════════════════════════════════╗'
    say '║        DARK NOC // SERVER CONTROL            ║'
    say '║              @mikakhadm                      ║'
    say '╚══════════════════════════════════════════════╝'
    printf '%s' "$RESET"
    printf '%sPanel:%s %s\n\n' "$DIM" "$RESET" "$(panel_url)"
    say '  1) Status and panel URL'
    say '  2) Show login credentials'
    say '  3) Change username'
    say '  4) Change / reset password'
    say '  5) Change public panel port'
    say '  6) Set panel domain or IP'
    say '  7) Get / renew panel SSL'
    say '  8) Restart DARK NOC services'
    say '  9) View live Hub logs'
    say ' 10) Create local backup'
    say ' 11) Update DARK NOC'
    say '  0) Exit'
    say ""
    read -r -p "Select: " choice
    case "$choice" in
      1) show_status; pause_menu ;;
      2) show_credentials; pause_menu ;;
      3) change_username; pause_menu ;;
      4) change_password; pause_menu ;;
      5) change_port; pause_menu ;;
      6) change_host; pause_menu ;;
      7) renew_ssl; pause_menu ;;
      8) restart_services; pause_menu ;;
      9) journalctl -u dark-noc-hub.service -f -n 100 --no-pager || true ;;
      10) create_backup; pause_menu ;;
      11) run_update; pause_menu ;;
      0) exit 0 ;;
      *) warn "Unknown option"; pause_menu ;;
    esac
  done
}

require_root
require_hub
case "${1:-menu}" in
  menu) menu ;;
  status) show_status ;;
  credentials) show_credentials ;;
  set-port) [[ $# -eq 2 ]] || die "Usage: darknoc set-port PORT"; change_port "$2" ;;
  set-domain|set-host) [[ $# -eq 2 ]] || die "Usage: darknoc set-domain DOMAIN_OR_IP"; change_host "$2" ;;
  reset-password) [[ $# -eq 1 ]] || die "Run without a password argument so it does not enter shell history: darknoc reset-password"; change_password ;;
  set-username) [[ $# -eq 2 ]] || die "Usage: darknoc set-username USERNAME"; change_username "$2" ;;
  issue-ssl) issue_ssl ;;
  renew-ssl) renew_ssl ;;
  restart) restart_services ;;
  backup) create_backup ;;
  update) run_update ;;
  --apply-gateway) apply_gateway ;;
  *) die "Unknown command. Run: darknoc" ;;
esac
