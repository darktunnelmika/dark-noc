[Unit]
Description=DARK NOC Agent
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/opt/dark-noc-agent
Environment=DARK_NOC_AGENT_CONFIG=/etc/dark-noc-agent/config.json
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/dark-noc-agent/venv/bin/python /opt/dark-noc-agent/agent.py
Restart=always
RestartSec=3
NotifyAccess=main
WatchdogSec=90s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dark-noc-agent /etc/dark-noc-agent /etc/dark-backhaul /etc/dark-ghostpro /etc/dark-packetpro /etc/dark-realm /var/lib/dark-noc-acme /etc/letsencrypt /var/lib/letsencrypt /var/log/letsencrypt /etc/nginx/conf.d /etc/systemd/system -/etc/ufw /usr/local/bin

[Install]
WantedBy=multi-user.target
